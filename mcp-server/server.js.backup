
const express = require("express");
const { randomUUID } = require("crypto");
const path = require("path");
const fs = require("fs/promises");

const app = express();
app.use(express.json({ limit: "1mb" }));

const PORT = process.env.PORT || 3000;
const PROJECT_DIR = path.resolve(__dirname, "..");

const sessions = new Set();

function getProjectPath(relativePath = ".") {
  const resolved = path.resolve(PROJECT_DIR, relativePath);

  if (
    resolved !== PROJECT_DIR &&
    !resolved.startsWith(PROJECT_DIR + path.sep)
  ) {
    throw new Error("Access outside the project folder is not allowed.");
  }

  return resolved;
}

const tools = [
  {
    name: "list_project_files",
    description: "List files in the project folder.",
    inputSchema: {
      type: "object",
      properties: {
        folder: { type: "string", description: "Relative folder path" }
      }
    }
  },
  {
    name: "read_project_file",
    description: "Read a text file inside the project folder.",
    inputSchema: {
      type: "object",
      properties: {
        file: { type: "string", description: "Relative file path" }
      },
      required: ["file"]
    }
  }
];

async function handleRequest(message) {
  const { method, params = {}, id } = message;
  let result;

  if (method === "initialize") {
    result = {
      protocolVersion: params.protocolVersion || "2025-03-26",
      capabilities: { tools: {} },
      serverInfo: { name: "student-project-mcp", version: "1.0.0" }
    };
  } else if (method === "notifications/initialized") {
    return null;
  } else if (method === "ping") {
    result = {};
  } else if (method === "tools/list") {
    result = { tools };
  } else if (method === "tools/call") {
    const { name, arguments: args = {} } = params;

    if (name === "list_project_files") {
      const dir = getProjectPath(args.folder || ".");
      const entries = await fs.readdir(dir, { withFileTypes: true });

      result = {
        content: [{
          type: "text",
          text: entries
            .filter(entry => entry.name !== "node_modules" && !entry.name.startsWith("."))
            .map(entry => `${entry.isDirectory() ? "[DIR]" : "[FILE]"} ${entry.name}`)
            .join("\n") || "No files found."
        }]
      };
    } else if (name === "read_project_file") {
      const filePath = getProjectPath(args.file);

      if (path.basename(filePath) === ".env" ||
          args.file.split(/[\\/]/).includes("node_modules")) {
        throw new Error("Reading .env and node_modules is not allowed.");
      }

      const stat = await fs.stat(filePath);
      if (!stat.isFile() || stat.size > 100000) {
        throw new Error("Only text files up to 100 KB can be read.");
      }

      result = {
        content: [{ type: "text", text: await fs.readFile(filePath, "utf8") }]
      };
    } else {
      throw new Error("Unknown tool.");
    }
  } else {
    throw new Error("Unsupported method: " + method);
  }

  return { jsonrpc: "2.0", id, result };
}

app.post("/mcp", async (req, res) => {
  const sessionId = req.get("mcp-session-id");

  if (sessionId && !sessions.has(sessionId)) {
    return res.status(404).end();
  }

  try {
    const response = await handleRequest(req.body);

    if (req.body.method === "initialize") {
      const newSession = randomUUID();
      sessions.add(newSession);
      res.set("mcp-session-id", newSession);
    }

    if (response === null) return res.status(202).end();
    res.json(response);
  } catch (error) {
    res.status(400).json({
      jsonrpc: "2.0",
      id: req.body?.id ?? null,
      error: { code: -32000, message: error.message }
    });
  }
});

app.get("/mcp", (req, res) => {
  res.status(405).send("Use an MCP-compatible POST request.");
});

app.delete("/mcp", (req, res) => {
  const id = req.get("mcp-session-id");
  if (id) sessions.delete(id);
  res.status(200).end();
});

app.get("/", (req, res) => {
  res.send("Student Project MCP server is running.");
});

app.listen(PORT, "0.0.0.0", () => {
  console.log(`MCP server listening on port ${PORT}`);
});
