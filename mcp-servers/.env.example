# One .env shared by all four MCP servers. NEVER commit the real .env.

# --- HTTP mode only (Render). Not needed with --stdio. Min 32 chars. ---
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=

# --- github-mcp ---
# Fine-grained token, only this repo, permission: Contents = Read and write
GITHUB_TOKEN=
GITHUB_REPO=Dhanashree244/StudentManagementSystem
GITHUB_BRANCH=main
# Paths Claude may WRITE to (comma separated; trailing / = folder)
ALLOWED_WRITE_PREFIXES=frontend/,backend/,README.md,render.yaml

# --- vercel-mcp ---
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# only if the project belongs to a team
VERCEL_TEAM_ID=
# Project > Settings > Git > Deploy Hooks
VERCEL_DEPLOY_HOOK_URL=

# --- render-mcp ---
RENDER_API_KEY=
# srv-xxxxxxxx (backend web service)
RENDER_SERVICE_ID=

# --- students-mcp (talks to the live backend / MongoDB through its REST API) ---
BACKEND_URL=https://student-management-backend-191c.onrender.com
